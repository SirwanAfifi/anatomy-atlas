{
  "name": "anatomy-atlas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "check": "node --check src/app.js && node --check src/exercises.js && node --check src/exercise-browser.js && node --check src/exercise-media.js && node --check src/anatomy.js && node --check src/viewer.js && node --check server.mjs && node --check vite.config.js && node --check scripts/build.mjs && node scripts/check-anatomy.mjs && node --test tests/exercises-data.test.js tests/exercise-media.test.js",
    "check:anatomy": "node scripts/check-anatomy.mjs",
    "test": "playwright test --config tests/playwright.config.js",
    "fetch:anatomy": "node scripts/fetch-anatomy.mjs",
    "prepare:anatomy": "node scripts/convert-anatomy.mjs",
    "import:exercises": "node scripts/import-exercises.mjs",
    "test:exercises": "node --test tests/exercises-data.test.js tests/exercise-media.test.js",
    "import:exercise-media": "node scripts/import-exercise-media.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "meshoptimizer": "^1.3.0",
    "vite": "^8.3.5"
  }
}
